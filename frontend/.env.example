# AllDown frontend configuration

# The FastAPI backend origin. Server-side only — the browser never sees it, because every
# request goes through the proxy route handlers in app/api/*.
API_URL=http://127.0.0.1:8000

# Canonical site origin. Used for metadataBase, the sitemap, robots.txt and OG tags.
NEXT_PUBLIC_SITE_URL=https://alldown.app

# Optional analytics id. Nothing is loaded when this is unset.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
