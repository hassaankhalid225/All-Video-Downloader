# AllDown backend configuration
# Copy to .env and adjust. Every value below is the default.

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-IP request budgets.
RATE_LIMIT_PER_MINUTE=20
DOWNLOAD_RATE_LIMIT_PER_MINUTE=10

# Preview cache. Safe to keep long: byte delivery runs its own freshness check and
# re-extracts, so a cached preview never hands out an expired media URL.
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=1024

# Transfer ceiling and download-token lifetime.
MAX_DOWNLOAD_SIZE_MB=500
TOKEN_TTL_SECONDS=300

# Deadlines for the two blocking operations.
EXTRACT_TIMEOUT_SECONDS=45
RENDER_TIMEOUT_SECONDS=300

# REQUIRED IN PRODUCTION. Signs /api/file tokens; leaving it unset generates a new key on
# every boot, which invalidates in-flight downloads and breaks multi-instance deployments.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional Netscape-format cookie jar. Instagram, Facebook and age-gated YouTube need one
# for anything beyond fully public content. Export it from a logged-in browser profile.
# COOKIES_FILE=/app/cookies.txt

# Optional upstream proxy. Datacenter IP ranges are rate-limited harder than residential
# ones by TikTok and Instagram; a residential proxy raises the success rate in production.
# YTDLP_PROXY=http://user:pass@host:port

# Prime the extractor caches at boot with one throwaway extraction. Without it the first
# visitor after a deploy waits several extra seconds while yt-dlp fetches and parses
# YouTube's player JavaScript.
WARM_UP=true

# Verbose logs, /docs, and raw extractor errors in responses. Never enable in production.
DEBUG=false

# Override the temp directory used for muxed and transcoded renders.
# TEMP_DIR=/tmp
